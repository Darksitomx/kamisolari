rasgo Saludar {
    funcion saludo(&yo) -> Texto;
}

estructura Persona {
    nombre: Texto,
}

implementa Saludar para Persona {
    funcion saludo(&yo) -> Texto {
        formato!("hola, {}", yo.nombre)
    }
}

funcion principal() {
    sea p = Persona {
        nombre: "Mila".into(),
    };
    imprimir("{}", p.saludo());
}
